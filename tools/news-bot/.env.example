# Copia in .env (o inserisci i valori nell'interfaccia di Coolify). NON committare .env.

# Credenziali MQTT: scegli password lunghe e casuali, diverse tra loro.
MQTT_PUBLISHER_USER=newsbot
MQTT_PUBLISHER_PASSWORD=cambiami
MQTT_BBS_USER=bbs
MQTT_BBS_PASSWORD=cambiami-anche-me

# Topic MQTT (default bbs/news)
NEWS_TOPIC=bbs/news

# Chiave HMAC condivisa col BBS (base64, 32 byte). Generala con:
#   python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
NEWS_HMAC_KEY=

# Ogni quanti minuti leggere i feed
POLL_MINUTES=15
# Massimo di notizie pubblicate per esecuzione (tutti i feed insieme)
MAX_PER_RUN=5
# Ore silenziose (Europe/Rome), es. 23-7. Vuoto = sempre attivo.
QUIET_HOURS=
TZ=Europe/Rome

# Porta pubblica del broker sull host (default 1884)
MQTT_PUBLIC_PORT=1884
